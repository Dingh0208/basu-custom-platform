MAAS_API_KEY=your-key-here
MAAS_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
MAAS_ASR_MODEL=qwen3-asr-flash
MAAS_SUMMARY_MODEL=qwen3.8-flash
