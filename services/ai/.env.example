# Optional: override the bundled WeChat engine path/data directory.
# Default engine: services/wechat-engine/wechat-backend.exe (included in the app).
WECHAT_DATA_ANALYSIS_BACKEND=
WECHAT_DATA_ANALYSIS_DATA_DIR=
WECHAT_DATA_ANALYSIS_PORT=10393
